# 复制成 <project>/<env>/db.secret.env 后填真值。
# 文件名必须以 .secret.env 结尾——provision-db.sh 会强制检查，.gitignore 也是按这个后缀挡的。

# ---- 选一种连接方式 ----
# psql        本机/跳板机能直连 PG（miniapp prod 腾讯云 CDB、IM RDS）
# ssh-docker  ssh 到主机再 docker exec psql（miniapp test 的 dev-postgres17）
# jump-psql   ssh 跳板机后在跳板机上跑 psql
MODE=psql

PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
ADMIN_DB=postgres          # 建库时连的维护库，一般是 postgres

# ---- MODE=ssh-docker 才需要 ----
#SSH_HOST=43.129.216.91
#SSH_USER=ubuntu
#SSH_KEY=~/.ssh/dev_zz.pem
#PG_CONTAINER=dev-postgres17

# ---- MODE=jump-psql 才需要 ----
#JUMP_HOST=prod-jenkins     # test/stage 用 test-jenkins
